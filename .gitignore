# Large Google SDK binaries and generated release artifacts stay outside Git.
/stage/sdk/
/stage/data/
/dist/
/downloads/
/build/
/artifacts/
/backups/
/releases/
/tests/*.log
/server/repository/
/stage/update/ArtemisUpdate.apk
/stage/update/*.idsig
/android/updater/build/

# Local signing material, credentials, and transient machine state.
/.secrets/
*.keystore
*.jks
*.p12
*.pfx
*.dpapi
*.pem
*.key
*.private.xml
.env
.env.*
!.env.example
Thumbs.db
